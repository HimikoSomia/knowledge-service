<% content_for :title, "Chat with #{@workspace.name}" %>
<% if @workspace_questions.any? { |question| question.pending? || question.answering? } %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="2">
  <% end %>
<% end %>

<div class="mx-auto flex min-h-[calc(100vh-10rem)] max-w-5xl flex-col gap-4">
  <div class="flex flex-col gap-3 border-b border-base-300 pb-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <%= link_to "← Back to workspace", workspace_path(@workspace), class: "link link-hover text-sm" %>
      <h1 class="mt-2 text-2xl font-bold">Chat with <%= @workspace.name %></h1>
      <p class="mt-1 text-sm text-base-content/60">
        Answers use this workspace's documents, notes, and memos and include the supporting sources.
      </p>
    </div>
    <span class="badge badge-outline self-start"><%= pluralize(@workspace_questions.size, "question") %></span>
  </div>

  <div id="workspace-conversation" class="flex-1 space-y-8 rounded-box border border-base-300 bg-base-100 p-4 shadow-sm sm:p-6">
    <% if @workspace_questions.empty? %>
      <div class="flex min-h-64 items-center justify-center text-center">
        <div class="max-w-md">
          <h2 class="text-lg font-semibold">Ask about your workspace</h2>
          <p class="mt-2 text-sm text-base-content/60">
            Try asking for a summary, a decision, a risk, or a next action found in your workspace knowledge.
          </p>
        </div>
      </div>
    <% end %>

    <% @workspace_questions.reverse_each do |question| %>
      <div id="workspace_question_<%= question.id %>" class="scroll-mt-6 space-y-3">
        <div class="chat chat-end">
          <div class="chat-header mb-1 text-xs text-base-content/60">
            You
            <time class="ml-1"><%= short_date_time(question.created_at) %></time>
          </div>
          <div class="chat-bubble chat-bubble-primary whitespace-pre-wrap"><%= question.question %></div>
        </div>

        <div class="chat chat-start">
          <div class="chat-header mb-1 text-xs text-base-content/60">
            Workspace assistant
            <span class="ml-1"><%= question.status.humanize %></span>
          </div>

          <% if question.pending? || question.answering? %>
            <div class="chat-bubble bg-base-200 text-base-content">
              <span class="loading loading-dots loading-sm mr-2 align-middle"></span>
              <span>Searching workspace knowledge and preparing a grounded answer&hellip;</span>
            </div>
          <% elsif question.answered? %>
            <div class="chat-bubble max-w-3xl bg-base-200 text-base-content">
              <div class="prose max-w-none text-base-content"><%= simple_format(question.answer) %></div>
            </div>

            <% if question.citations.any? %>
              <div class="chat-footer mt-3 w-full max-w-3xl space-y-2 text-left">
                <p class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Sources</p>
                <% question.citations.each do |citation| %>
                  <div id="source-<%= citation["number"] %>-question-<%= question.id %>" class="rounded-lg border border-base-300 bg-base-100 p-3 text-sm">
                    <div class="flex flex-wrap items-center gap-2 font-semibold">
                      <span>[<%= citation["number"] %>]</span>
                      <% if citation["source_type"] == "document" %>
                        <%= link_to citation["title"], document_path(citation["source_id"]), class: "link link-primary" %>
                      <% elsif KnowledgeSource.source_types.key?(citation["source_type"]) %>
                        <%= link_to citation["title"],
                              edit_workspace_knowledge_source_path(@workspace, citation["source_id"]),
                              class: "link link-primary" %>
                      <% else %>
                        <span><%= citation["title"] %></span>
                      <% end %>
                      <span class="font-normal text-base-content/50"><%= citation["locator"] %></span>
                    </div>
                    <p class="mt-2 text-base-content/70"><%= citation["excerpt"] %></p>
                  </div>
                <% end %>
              </div>
            <% end %>
          <% elsif question.insufficient_context? %>
            <div class="chat-bubble bg-warning text-warning-content"><%= question.answer %></div>
          <% else %>
            <div class="chat-bubble bg-error text-error-content">
              <p><%= workspace_question_error_message(question) %></p>
              <%= button_to "Retry answer",
                    workspace_question_retry_path(@workspace, question),
                    method: :post,
                    class: "btn btn-sm mt-3" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="sticky bottom-3 rounded-box border border-base-300 bg-base-100 p-3 shadow-lg sm:p-4">
    <% if @workspace_question.errors.any? %>
      <div id="question_error_explanation" class="alert alert-error mb-3">
        <ul class="list-disc pl-5">
          <% @workspace_question.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @workspace_question,
          url: workspace_questions_path(@workspace),
          class: "flex items-end gap-2" do |form| %>
      <div class="flex-1">
        <%= form.label :question, "Message", class: "sr-only" %>
        <%= form.text_area :question,
              rows: 2,
              maxlength: WorkspaceQuestion::MAX_QUESTION_LENGTH,
              placeholder: "Ask a question about this workspace…",
              class: "textarea textarea-bordered w-full resize-none",
              required: true %>
      </div>
      <%= form.submit "Send", class: "btn btn-primary" %>
    <% end %>
    <p class="mt-2 text-xs text-base-content/50">Answers may be incomplete. Check the cited workspace sources.</p>
  </div>
</div>

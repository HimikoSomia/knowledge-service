<% content_for :title, "Questions for #{@workspace.name}" %>

<div class="mx-auto max-w-4xl space-y-6">
  <div>
    <%= link_to "← Back to #{@workspace.name}", workspace_path(@workspace), class: "link link-hover text-sm" %>
    <h1 class="mt-3 text-2xl font-bold">Workspace questions</h1>
  </div>

  <div class="space-y-3">
    <% @workspace_questions.each do |question| %>
      <%= link_to workspace_question_path(@workspace, question), class: "block rounded-lg border border-base-300 bg-base-100 p-4 hover:border-primary" do %>
        <div class="flex items-start justify-between gap-4">
          <span><%= question.question %></span>
          <span class="badge badge-ghost"><%= question.status.humanize %></span>
        </div>
        <p class="mt-2 text-xs text-base-content/50"><%= short_date_time(question.created_at) %></p>
      <% end %>
    <% end %>

    <% if @workspace_questions.empty? %>
      <div class="rounded-lg border border-base-300 bg-base-100 p-8 text-center text-sm text-base-content/60">
        No questions have been asked yet.
      </div>
    <% end %>
  </div>
</div>

<% content_for :title, "Workspace answer" %>
<% if @workspace_question.pending? || @workspace_question.answering? %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="2">
  <% end %>
<% end %>

<div class="mx-auto max-w-4xl space-y-6">
  <div>
    <%= link_to "← Back to #{@workspace.name}", workspace_path(@workspace), class: "link link-hover text-sm" %>
    <h1 class="mt-3 text-2xl font-bold">Workspace question</h1>
  </div>

  <div class="rounded-lg border border-base-300 bg-base-100 p-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Question</p>
    <p class="mt-2 text-lg"><%= @workspace_question.question %></p>
  </div>

  <% if @workspace_question.pending? || @workspace_question.answering? %>
    <div class="alert alert-info">
      <span>Searching workspace knowledge and preparing a grounded answer&hellip;</span>
    </div>
  <% elsif @workspace_question.answered? %>
    <div class="rounded-lg border border-base-300 bg-base-100 p-5">
      <h2 class="text-sm font-semibold">Answer</h2>
      <div class="prose mt-3 max-w-none text-base-content"><%= simple_format(@workspace_question.answer) %></div>
    </div>

    <div class="space-y-3">
      <h2 class="text-sm font-semibold">Sources</h2>
      <% @workspace_question.citations.each do |citation| %>
        <div id="source-<%= citation["number"] %>" class="rounded-lg border border-base-300 bg-base-100 p-4">
          <div class="flex flex-wrap items-center gap-2 text-sm font-semibold">
            <span>[<%= citation["number"] %>]</span>
            <% if citation["source_type"] == "document" %>
              <%= link_to citation["title"], document_path(citation["source_id"]), class: "link link-primary" %>
            <% else %>
              <span><%= citation["title"] %></span>
            <% end %>
            <span class="font-normal text-base-content/50"><%= citation["locator"] %></span>
          </div>
          <p class="mt-2 text-sm text-base-content/70"><%= citation["excerpt"] %></p>
        </div>
      <% end %>
    </div>
  <% elsif @workspace_question.insufficient_context? %>
    <div class="alert alert-warning"><span><%= @workspace_question.answer %></span></div>
  <% else %>
    <div class="alert alert-error">
      <span><%= workspace_question_error_message(@workspace_question) %></span>
    </div>
  <% end %>
</div>

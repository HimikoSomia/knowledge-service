PORT=3000
HOST=localhost

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# OpenAI (required for document embedding and semantic search)
OPENAI_API_KEY=sk-your-openai-api-key

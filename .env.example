PORT=3000
HOST=localhost

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# OpenAI (required for document embedding and semantic search)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_BATCH_SIZE=100
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_ANSWER_MODEL=gpt-4o-mini
OPENAI_ANSWER_MAX_TOKENS=1200

# Grounded workspace Q&A retrieval controls
WORKSPACE_QA_CANDIDATE_LIMIT=24
WORKSPACE_QA_MAX_DISTANCE=0.55
WORKSPACE_QA_MAX_CONTEXT_CHARS=16000
WORKSPACE_QA_MAX_RESULTS_PER_SOURCE=3
